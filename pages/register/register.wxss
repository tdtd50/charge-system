.register-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.logo {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
  text-align: center;
  display: block;
  width: 100%;
}

.form {
  width: 100%;
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item input {
  width: 100%;
  height: 88rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.login-link {
  text-align: center;
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.link {
  color: #1989fa;
  margin-left: 10rpx;
}
