.orders-container {
  padding: 30rpx;
}

.order-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-id {
  font-size: 28rpx;
  color: #666;
}

.order-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.status-finished {
  background: #f0f0f0;
  color: #999;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  font-size: 28rpx;
  color: #333;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.empty text {
  font-size: 28rpx;
  color: #999;
}
