.charge-container {
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.welcome {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
}

.balance-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.balance-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.balance-info .label {
  color: white;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.balance-info .amount {
  color: white;
  font-size: 60rpx;
  font-weight: bold;
}

.amount-selector {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 30rpx;
  display: block;
}

.amount-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
}

.amount-item {
  flex: 0 0 calc(50% - 10rpx);
  background: white;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  position: relative;
  z-index: 1;
}

.amount-item.active {
  border-color: #1989fa;
  background: #e6f7ff;
}

.amount-item .amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  pointer-events: none;
}

.amount-item .time {
  font-size: 24rpx;
  color: #999;
  pointer-events: none;
}

.charging-status {
  margin-bottom: 40rpx;
}

.status-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
}

.status-title {
  font-size: 32rpx;
  color: #52c41a;
  font-weight: bold;
  display: block;
  text-align: center;
  margin-bottom: 30rpx;
}

.countdown {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
  gap: 20rpx;
}

.countdown-text {
  font-size: 28rpx;
  color: #666;
}

.countdown-time {
  font-size: 48rpx;
  color: #52c41a;
  font-weight: bold;
}

.charge-btn {
  width: 100%;
  height: 88rpx;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
